---
import ToolSection from '../components/ToolSection.astro';
import { TOOLS } from '../data/tools';
import Base from '../layouts/Base.astro';

const GITHUB_URL = 'https://github.com/AxerieSoftware';
const YEAR = 2026;
---

<Base title="Axerie" description="Free, open-source tools that add what the software you already use doesn’t do yet.">
	<header class="wrap top">
		<a class="wordmark" href="/" aria-label="Axerie home">Axerie</a>
		<a href={GITHUB_URL}>GitHub</a>
	</header>

	<main class="wrap">
		<h1 class="visually-hidden">Axerie tools</h1>

		{TOOLS.map((tool, index) => <ToolSection tool={tool} isFirst={index === 0} isReversed={index % 2 === 1} />)}
	</main>

	<footer class="wrap bottom">
		<p>© {YEAR} Axerie LLC. Every tool is free and open source, with the code on <a href={GITHUB_URL}>GitHub</a>.</p>
	</footer>
</Base>

<style>
	.top {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding-block: 1.75rem;
	}
	.top a:not(.wordmark) {
		color: var(--ink-2);
	}
	.top a:not(.wordmark):hover {
		color: var(--ink);
	}
	.wordmark {
		font: 700 1.375rem / 1 var(--font-display);
		letter-spacing: -0.02em;
		text-decoration: none;
	}

	.bottom {
		padding-block: 2.5rem 3.5rem;
		border-top: 1px solid var(--line);
		color: var(--ink-2);
		font-size: 1rem;
	}
	.bottom p {
		margin: 0;
	}
</style>
